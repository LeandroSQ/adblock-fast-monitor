{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Bash(git push:*)",
			"Bash(git tag:*)",
			"Bash(git remote set-url:*)",
			"Bash(gh workflow:*)",
			"Bash(gh run rerun:*)",
			"Bash(gh run cancel:*)",
			"Bash(gh release:*)",
			"Bash(gh secret:*)",
			"Bash(gh variable:*)",
			"Bash(gh repo edit:*)",
			"Bash(gh api:*)",
			"Bash(ssh:*)",
			"Bash(scp:*)",
			"Read(./**/*.key)",
			"Read(./**/*.key.pem)",
			"Read(./**/*private*.pem)",
			"Read(~/.afm-keys/**)"
		]
	}
}
