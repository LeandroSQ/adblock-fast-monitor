# syntax=docker/dockerfile:1
# Linux toolbox for the parts of validation that need Linux: the OpenWrt SDK
# package build (x86_64 binaries: run with --platform linux/amd64) and QEMU
# guests (any platform; native is fastest under TCG). Used by scripts/in-docker.sh.
FROM node:22-bookworm

RUN apt-get update && apt-get install --yes --no-install-recommends \
    bzip2 ca-certificates curl dnsutils file gawk git make openssh-client \
    openssl python3 qemu-system-x86 qemu-utils rsync unzip wget xz-utils zstd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
