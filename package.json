{
  "name": "adblock-fast-monitor-test-infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "Host-side CI and verification tooling for adblock-fast-monitor",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:contract": "node --test test/contract/*.test.mjs",
    "test:browser": "node scripts/run-browser-required.mjs",
    "test:browser:required": "node scripts/run-browser-required.mjs",
    "test:qemu": "bash scripts/integration/run-openwrt-qemu.sh",
    "test:performance": "node scripts/performance-gate.mjs",
    "test:performance:measure": "node scripts/integration/measure-performance.mjs && PERFORMANCE_REQUIRE_MEASURED=1 npm run test:performance",
    "verify:host": "npm run check:static && npm run check:schema && npm run test:unit && npm run test:contract && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  }
}
