{
  "name": "adblock-fast-monitor-test-infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "Host-side CI and verification tooling for adblock-fast-monitor",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:userland": "scripts/build-host-ucode.sh",
    "build:package": "scripts/build-package.sh",
    "check:static": "node scripts/check-static.mjs",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=\"htdocs/**\" --test-coverage-lines=98 --test-coverage-branches=90 --test-coverage-functions=95 \"test/unit/**/*.test.mjs\"",
    "test:ucode": "test/lib/run-tests ucode",
    "test:shell": "test/lib/run-tests shell",
    "test:guest": "scripts/guest/run-guest-tests.sh",
    "test:qemu": "scripts/guest/run-guest-tests.sh",
    "test:browser": "node scripts/run-browser-required.mjs",
    "test:browser:required": "node scripts/run-browser-required.mjs",
    "test:performance": "node scripts/performance-gate.mjs",
    "test:performance:measure": "node scripts/integration/measure-performance.mjs",
    "verify:host": "npm run check:static && npm run test:unit && npm run test:ucode && npm run test:shell",
    "verify:guest": "scripts/verify-guest.sh",
    "test:mutation": "stryker run test/mutation/stryker.config.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.55.1",
    "@stryker-mutator/core": "9.3.0",
    "ajv": "8.17.1"
  }
}
