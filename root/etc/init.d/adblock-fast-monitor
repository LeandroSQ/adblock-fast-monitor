#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# Query-logging drop-in reconciliation (docs/CONTRACT.md §4). A procd service
# with no instance: nothing stays running. START=18 runs before dnsmasq (19),
# so writing the drop-ins at boot never restarts it (P10).
START=18
USE_PROCD=1

LOGGING=/usr/libexec/adblock-fast-monitor/logging.uc

start_service() {
	local query_logging
	config_load adblock-fast-monitor
	config_get_bool query_logging config query_logging 0

	if [ "$query_logging" = 1 ]; then
		"$LOGGING" enable
	else
		"$LOGGING" disable
	fi
}

stop_service() {
	# restart = stop + start with the same configuration: keep the drop-ins
	# so dnsmasq is not restarted twice; start_service reconciles them.
	[ "$action" = restart ] || "$LOGGING" disable
}

service_triggers() {
	local query_logging
	procd_add_reload_trigger adblock-fast-monitor
	config_load adblock-fast-monitor
	config_get_bool query_logging config query_logging 0
	# A logd restart (LuCI System -> Logging save, `/etc/init.d/log restart`)
	# leaves the jailed dnsmasq writing to a dead /dev/log. procd raises
	# instance.update whenever any instance starts or stops; 3 s after the
	# last one, reload, which restarts dnsmasq only if its /dev/log is stale
	# (docs/CONTRACT.md §4, §11 P10 exception). Only while query logging is on.
	[ "$query_logging" = 1 ] &&
		procd_add_raw_trigger instance.update 3000 /etc/init.d/adblock-fast-monitor reload
	return 0
}
