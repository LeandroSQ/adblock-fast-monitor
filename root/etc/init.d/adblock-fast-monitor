#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# Monitor daemon lifecycle (docs/CONTRACT.md §4.1). START=18 runs before
# dnsmasq (19), so writing the query-logging drop-ins at boot never restarts it.
START=18
USE_PROCD=1

LOGGING=/usr/libexec/adblock-fast-monitor/logging.uc
DAEMON=/usr/libexec/adblock-fast-monitor/monitord.uc

start_service() {
	local enabled manage_logging
	config_load adblock-fast-monitor
	config_get_bool enabled config enabled 0
	config_get_bool manage_logging config manage_logging 1

	if [ "$enabled" != 1 ]; then
		# No instance: procd stops any previous one, so nothing runs.
		"$LOGGING" disable
		return 0
	fi

	if [ "$manage_logging" = 1 ]; then
		"$LOGGING" enable
	else
		"$LOGGING" disable
	fi

	procd_open_instance
	procd_set_param command "$DAEMON"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/adblock-fast-monitor
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# restart = stop + start with the same configuration: keep the drop-ins
	# so dnsmasq is not restarted twice; start_service reconciles them.
	[ "$action" = restart ] || "$LOGGING" disable
}

service_triggers() {
	procd_add_reload_trigger adblock-fast-monitor
}
