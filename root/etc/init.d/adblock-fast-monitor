#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=95
USE_PROCD=1

start_service() {
	mkdir -p /var/run/adblock-fast-monitor
	chmod 0700 /var/run/adblock-fast-monitor
	procd_open_instance
	procd_set_param command /usr/libexec/adblock-fast-monitor-collector
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/adblock-fast-monitor
	procd_close_instance
}

stop_service() {
	/usr/libexec/adblock-fast-monitor-collector cleanup
}

service_triggers() {
	procd_add_config_trigger "config.change" "adblock-fast-monitor" /etc/init.d/adblock-fast-monitor restart
}
