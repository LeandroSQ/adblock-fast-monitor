#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Migrates a v1 (api 1) configuration to v2 (docs/CONTRACT.md §3): the daemon
# switch `enabled` (with `manage_logging`) becomes `query_logging`, and the
# daemon-only options are removed. Idempotent; runs on install, upgrade and
# first boot.
c=adblock-fast-monitor.config
uci -q get "$c" >/dev/null || exit 0

is_true() { case "$1" in 1|on|true|yes|enabled) return 0 ;; esac; return 1; }
is_false() { case "$1" in 0|off|false|no|disabled) return 0 ;; esac; return 1; }

old=$(uci -q get "$c.enabled")
if [ -n "$old" ] && [ -z "$(uci -q get "$c.query_logging")" ]; then
	ql=0
	is_true "$old" && ql=1
	# v1 with manage_logging=0 never wrote drop-ins.
	is_false "$(uci -q get "$c.manage_logging")" && ql=0
	uci set "$c.query_logging=$ql"
fi
for o in enabled manage_logging recent_size top_size pending_size pending_ttl record_clients max_events own_logqueries; do
	uci -q delete "$c.$o"
done
[ -z "$(uci -q changes adblock-fast-monitor)" ] || uci commit adblock-fast-monitor
exit 0
