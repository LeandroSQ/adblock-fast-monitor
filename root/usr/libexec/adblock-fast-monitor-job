#!/bin/sh
# SPDX-License-Identifier: Apache-2.0

# This worker intentionally uses only adblock-fast's public init actions and UCI.
# It never changes generated lists or invokes an arbitrary command supplied by RPC.
. /usr/lib/adblock-fast-monitor/common.sh

STATE_DIR="$MONITOR_STATE"
JOB_FILE="$STATE_DIR/job"
LOCK_DIR="$STATE_DIR/action.lock"
PSL_FILE=/usr/share/publicsuffix/public_suffix_list.dat
ACTION_TIMEOUT=120

action="$1"
domain="$2"
lock_held="$3"
rebuild_confirmed="$4"

action_state_init() {
	# Do not repair state ownership or permissions here: a prior insecure state
	# may already have disclosed rule names.
	for protected_path in "$MONITOR_STATE" "$MONITOR_JOB" "$LOCK_DIR"; do
		[ -L "$protected_path" ] && return 1
		[ -e "$protected_path" ] || continue
		[ "$(stat -c '%u' "$protected_path" 2>/dev/null)" = 0 ] || return 1
		case "$protected_path" in
			"$MONITOR_STATE") [ -d "$protected_path" ] && [ "$(stat -c '%a' "$protected_path" 2>/dev/null)" = 700 ] || return 1 ;;
			"$MONITOR_JOB") [ -f "$protected_path" ] && [ "$(stat -c '%a' "$protected_path" 2>/dev/null)" = 600 ] || return 1 ;;
			"$LOCK_DIR") [ -d "$protected_path" ] && [ "$(stat -c '%a' "$protected_path" 2>/dev/null)" = 700 ] || return 1 ;;
		esac
	done
	monitor_state_init
}

write_job() {
	umask 077
	tmp="$(mktemp "$STATE_DIR/.job.XXXXXX")" || return 1
	job_domain="$domain"
	case "$job_domain" in ''|*[!a-z0-9.-]*) job_domain=invalid ;; esac
	{
		printf 'state=%s\n' "$1"
		printf 'result=%s\n' "$2"
		printf 'action=%s\n' "$action"
		printf 'domain=%s\n' "$job_domain"
		printf 'current_rule=%s\n' "$3"
		printf 'persisted=%s\n' "$4"
		printf 'rebuild=%s\n' "$5"
		printf 'active_dns=%s\n' "$6"
		printf 'message=%s\n' "$7"
	} > "$tmp" && chown root:root "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$JOB_FILE"
}

release_lock() {
	[ "$lock_held" = held ] && rmdir "$LOCK_DIR" 2>/dev/null || true
}

finish() {
	write_job "$@"
	release_lock
	exit 0
}

has_rule() {
	uci -q get "adblock-fast.config.$1" 2>/dev/null |
		tr ' ' '\n' | grep -Fqx -- "$domain"
}

validate_domain() {
	[ -n "$domain" ] && [ "${#domain}" -le 253 ] || return 1
	case "$domain" in
		.*|*.|*..*|*/*|*\\*|*\"*|*\'*|*[\ \	]*|*[!a-z0-9.-]*) return 1 ;;
	esac

	label_count=0
	old_ifs="$IFS"
	IFS=.
	set -- $domain
	IFS="$old_ifs"
	for label; do
		[ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
		case "$label" in *-|-*) return 1 ;; esac
		label_count=$((label_count + 1))
	done
	# A domain must include a registrable label as well as a public suffix.
	[ "$label_count" -ge 2 ] || return 1
}

is_public_suffix() {
	# A complete PSL is required; guessing would make broad rules unsafe.
	[ -r "$PSL_FILE" ] || return 2
	awk -v candidate="$domain" '
		/^[[:space:]]*($|\/\/)/ { next }
		{
			gsub(/\r$/, "")
			if ($0 == "!" candidate) exception = 1
			else if ($0 == candidate) found = 1
			else if ($0 ~ /^\*\./) {
				suffix = substr($0, 3)
				if (candidate ~ ("^[^.]+\\." suffix "$")) found = 1
			}
		}
		END { exit found && !exception ? 0 : 1 }
	' "$PSL_FILE"
}

run_rebuild() {
	timeout "$ACTION_TIMEOUT" /etc/init.d/adblock-fast dl >/dev/null 2>&1
}

action_state_init || exit 1

case "$action" in allow|unallow|block|unblock) ;; *)
	write_job rejected invalid-action unknown 0 not-requested unknown 'Unsupported action.'
	exit 0
	;; esac

if ! validate_domain; then
	write_job rejected invalid-domain unknown 0 not-requested unknown 'Domain must be a lowercase, fully-qualified hostname without wildcards or broad syntax.'
	exit 0
fi

is_public_suffix
psl_status=$?
if [ "$psl_status" = 0 ]; then
	write_job rejected public-suffix unknown 0 not-requested unknown 'Refusing a public-suffix rule.'
	exit 0
fi
case "$psl_status" in
	2)
		write_job failed public-suffix-data-unavailable unknown 0 not-requested unknown 'Public suffix data is unavailable; refusing to apply a potentially broad rule.'
		exit 0
		;;
esac

if [ "$lock_held" = held ]; then
	# The RPC adapter acquired this exact lock before it forked us.
	:
elif mkdir "$LOCK_DIR" 2>/dev/null; then
	lock_held=held
else
	write_job rejected busy unknown 0 not-requested unknown 'Another domain-rule operation is already running.'
	exit 0
fi
trap release_lock EXIT HUP INT TERM

allowed=0
blocked=0
has_rule allowed_domain && allowed=1
has_rule blocked_domain && blocked=1
case "$allowed:$blocked" in
	1:1)
		finish rejected conflict conflict 1 not-requested unknown 'The domain is both allowed and blocked; resolve the conflicting configuration manually.'
		;;
esac

case "$action" in
	allow)
		[ "$blocked" = 0 ] || finish rejected conflict block 1 not-requested unknown 'A block rule already applies to this domain.'
		[ "$allowed" = 0 ] || finish completed noop allow 1 not-required unknown 'Allow rule already exists; no change was made.'
		write_job applying running none 0 not-required unknown 'Persisting allow rule through adblock-fast.'
		timeout "$ACTION_TIMEOUT" /etc/init.d/adblock-fast allow "$domain" >/dev/null 2>&1 || true
		if has_rule allowed_domain; then
			finish degraded persisted-active-unknown allow 1 resolver-restart-requested unknown 'Allow rule persisted. adblock-fast requested a resolver restart, but active DNS is not verifiable for cached, CNAME, or IPv6 responses.'
		fi
		finish failed allow-not-persisted none 0 not-required unknown 'adblock-fast allow did not persist the rule.'
		;;
	block)
		[ "$rebuild_confirmed" = confirmed ] ||
			finish rejected confirmation-required none 0 not-started unknown 'A full rebuild was not started because explicit confirmation is required.'
		[ "$allowed" = 0 ] || finish rejected conflict allow 1 not-requested unknown 'An allow rule already applies to this domain.'
		[ "$blocked" = 0 ] || finish completed noop block 1 not-required unknown 'Block rule already exists; no change was made.'
		write_job applying running none 0 requested unknown 'Persisting block rule and running the required full rebuild.'
		if uci -q add_list "adblock-fast.config.blocked_domain=$domain" &&
			uci -q commit adblock-fast &&
			has_rule blocked_domain &&
			run_rebuild; then
			finish degraded persisted-active-unknown block 1 completed unknown 'Block rule persisted and rebuild completed. Active DNS is not verifiable for cached, CNAME, or IPv6 responses.'
		fi
		persisted=0
		has_rule blocked_domain && persisted=1
		current_rule=none
		[ "$persisted" = 1 ] && current_rule=block
		finish failed rebuild-failed-active-unverified "$current_rule" "$persisted" failed unknown 'Block rule persistence was rechecked, but the rebuild failed. No further DNS restart was attempted, so any prior active blocking was left for adblock-fast to preserve; its active state could not be verified.'
		;;
	unallow)
		[ "$rebuild_confirmed" = confirmed ] ||
			finish rejected confirmation-required allow 1 not-started unknown 'A full rebuild was not started because explicit confirmation is required.'
		[ "$allowed" = 1 ] || finish completed noop none 0 not-required unknown 'No allow rule exists; no change was made.'
		write_job applying running allow 1 requested unknown 'Removing allow rule and running the required full rebuild.'
		if uci -q del_list "adblock-fast.config.allowed_domain=$domain" &&
			uci -q commit adblock-fast &&
			! has_rule allowed_domain &&
			run_rebuild; then
			finish degraded persisted-active-unknown none 0 completed unknown 'Allow rule removed and rebuild completed. Active DNS is not verifiable for cached, CNAME, or IPv6 responses.'
		fi
		persisted=0
		! has_rule allowed_domain && persisted=1
		current_rule=allow
		[ "$persisted" = 1 ] && current_rule=none
		finish failed rebuild-failed-active-unverified "$current_rule" "$persisted" failed unknown 'Allow rule removal persistence was rechecked, but the rebuild failed. No further DNS restart was attempted, so any prior active blocking was left for adblock-fast to preserve; its active state could not be verified.'
		;;
	unblock)
		[ "$rebuild_confirmed" = confirmed ] ||
			finish rejected confirmation-required block 1 not-started unknown 'A full rebuild was not started because explicit confirmation is required.'
		[ "$blocked" = 1 ] || finish completed noop none 0 not-required unknown 'No block rule exists; no change was made.'
		write_job applying running block 1 requested unknown 'Removing block rule and running the required full rebuild.'
		if uci -q del_list "adblock-fast.config.blocked_domain=$domain" &&
			uci -q commit adblock-fast &&
			! has_rule blocked_domain &&
			run_rebuild; then
			finish degraded persisted-active-unknown none 0 completed unknown 'Block rule removed and rebuild completed. Active DNS is not verifiable for cached, CNAME, or IPv6 responses.'
		fi
		persisted=0
		! has_rule blocked_domain && persisted=1
		current_rule=block
		[ "$persisted" = 1 ] && current_rule=none
		finish failed rebuild-failed-active-unverified "$current_rule" "$persisted" failed unknown 'Block rule removal persistence was rechecked, but the rebuild failed. No further DNS restart was attempted, so any prior active blocking was left for adblock-fast to preserve; its active state could not be verified.'
		;;
esac
