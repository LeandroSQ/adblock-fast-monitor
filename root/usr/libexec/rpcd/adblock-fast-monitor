#!/bin/sh

# Read-only monitor RPC. It consumes collector-owned, bounded state; activity
# requests only scan that bounded file in shell and never invoke the collector.

STATE_DIR="${ADBLOCK_FAST_MONITOR_STATE:-/tmp/adblock-fast-monitor}"
EVENTS="$STATE_DIR/activity.tsv"
STATUS="$STATE_DIR/status"
LOCK="$STATE_DIR/monitor.lock"
GENERATION="$STATE_DIR/generation"

. /usr/share/libubox/jshn.sh

read_request() {
	local request
	IFS= read -r request
	json_load "${request:-{}}"
}

read_status() {
	state=disabled started=0 allowed=0 blocked=0 unknown=0 lost=0 capacity=0 snapshot_generation='' job=''
	[ -r "$STATUS" ] || return 0

	while IFS='=' read -r key value; do
		case "$key" in
			state) state="$value" ;;
			started) started="$value" ;;
			allowed) allowed="$value" ;;
			blocked) blocked="$value" ;;
			unknown) unknown="$value" ;;
			lost) lost="$value" ;;
			capacity) capacity="$value" ;;
			generation) snapshot_generation="$value" ;;
			job) job="$value" ;;
		esac
	done <"$STATUS"
	case "$allowed" in *[!0-9]*|'') allowed=0 ;; esac
	case "$blocked" in *[!0-9]*|'') blocked=0 ;; esac
	case "$unknown" in *[!0-9]*|'') unknown=0 ;; esac
	case "$lost" in *[!0-9]*|'') lost=0 ;; esac
	case "$capacity" in *[!0-9]*|'') capacity=0 ;; esac
}

snapshot_current() {
	local generation
	IFS= read -r generation <"$GENERATION"
	case "$generation:$snapshot_generation" in
		*[!0-9:]*|:) return 1 ;;
	esac
	[ "$generation" = "$snapshot_generation" ]
}

secure_state() {
	[ -d "$STATE_DIR" ] || return 1
	for file in "$EVENTS" "$STATUS" "$LOCK" "$GENERATION"; do
		[ -f "$file" ] || return 1
	done
}

status() {
	secure_state || { echo '{"state":"failed","started":"0","counters":{"allowed":0,"blocked":0,"unknown":0,"lost":0},"capacity":0}'; return; }
	read_status
	snapshot_current || { echo '{"state":"pending","started":"0","counters":{"allowed":0,"blocked":0,"unknown":0,"lost":0},"capacity":0}'; return; }
	json_init
	json_add_string state "$state"
	json_add_string started "$started"
	json_add_object counters
	json_add_int allowed "$allowed"
	json_add_int blocked "$blocked"
	json_add_int unknown "$unknown"
	json_add_int lost "$lost"
	json_close_object
	json_add_int capacity "$capacity"
	[ -n "$job" ] && json_add_string job "$job"
	json_dump
}

activity() {
	local cursor limit search filter line timestamp decision domain reason rest
	local reverse='' matched=0 emitted=0 next_cursor='' retained=0

	read_request
	secure_state || { echo '{"events":[],"retained":0,"lost":0}'; return; }
	json_get_var cursor cursor
	json_get_var limit limit
	json_get_var search search
	json_get_var filter filter
	case "$cursor" in *[!0-9]*|'') cursor=0 ;; esac
	case "$limit" in *[!0-9]*|'') limit=50 ;; esac
	[ "$limit" -gt 100 ] && limit=100
	[ "$limit" -lt 1 ] && limit=1
	read_status
	snapshot_current || { echo '{"events":[],"retained":0,"lost":0}'; return; }

	# activity.tsv is append-only oldest-first. Reversing the bounded contents
	# in shell yields newest-first without spawning a process per request.
	if [ -r "$EVENTS" ]; then
		while IFS= read -r line; do
			reverse="$line
$reverse"
			retained=$((retained + 1))
		done <"$EVENTS"
	fi

	json_init
	json_add_array events
	[ -n "$reverse" ] && while IFS="$(printf '\t')" read -r timestamp decision domain reason rest; do
		case "$filter" in ''|all|"$decision") ;; *) continue ;; esac
		case "$domain $reason $decision" in *"$search"*) ;; *) continue ;; esac
		[ "$matched" -lt "$cursor" ] && { matched=$((matched + 1)); continue; }
		if [ "$emitted" -ge "$limit" ]; then
			next_cursor="$matched"
			break
		fi
		json_add_object
		json_add_string timestamp "$timestamp"
		json_add_string decision "$decision"
		json_add_string domain "$domain"
		json_add_string reason "$reason"
		# The read API cannot and must not rescan active rules. A producer may
		# append this fifth field when it already knows the current state.
		json_add_string current_rule "${rest:-unknown}"
		json_close_object
		emitted=$((emitted + 1))
		matched=$((matched + 1))
	done <<-EOF
	$reverse
	EOF
	json_close_array
	[ -n "$next_cursor" ] && json_add_string next_cursor "$next_cursor"
	json_add_int retained "$retained"
	json_add_int lost "$lost"
	json_dump
}

purge() {
	local lines=0 key value generation

	[ -d "$STATE_DIR" ] || exit 1
	secure_state || exit 1
	umask 077
	lock "$LOCK" 2>/dev/null || exit 1
	trap 'lock -u "$LOCK" 2>/dev/null' EXIT INT TERM
	[ -r "$EVENTS" ] && while IFS= read -r _; do lines=$((lines + 1)); done <"$EVENTS"
	: >"$EVENTS" || exit 1
	read_status
	lost=$((lost + lines))
	IFS= read -r generation <"$GENERATION"
	case "$generation" in *[!0-9]*|'') generation=0 ;; esac
	printf '%s\n' "$((generation + 1))" >"$GENERATION.new" &&
		chown root:root "$GENERATION.new" && chmod 0600 "$GENERATION.new" &&
		mv "$GENERATION.new" "$GENERATION" || exit 1
	{
		while IFS='=' read -r key value; do
			[ "$key" = lost ] && continue
			[ "$key" = generation ] && continue
			printf '%s=%s\n' "$key" "$value"
		done <"$STATUS"
		printf 'lost=%s\n' "$lost"
		printf 'generation=%s\n' "$generation"
	} >"$STATUS.new" && chown root:root "$STATUS.new" && chmod 0600 "$STATUS.new" && mv "$STATUS.new" "$STATUS"
	echo '{"state":"applied"}'
}

case "$1" in
	list)
		echo '{"status":{},"activity":{"cursor":"String","limit":"Integer","search":"String","filter":"String"},"purge":{}}'
		;;
	status) status ;;
	activity) activity ;;
	purge) purge ;;
	*) exit 1 ;;
esac
