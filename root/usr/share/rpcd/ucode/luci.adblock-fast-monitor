// rpcd ucode plugin `luci.adblock-fast-monitor` (docs/CONTRACT.md §6, §7.1,
// §7.3). It runs inside rpcd's single-threaded uloop, so every method returns
// within milliseconds: all adblock-fast work runs in the detached job (job.uc).
'use strict';

const fs = require('fs');
const uci = require('uci');
const ubus = require('ubus');
const dom = require('abfm.domain');
const sys = require('abfm.system');

const API = 2;
const RUN_DIR = '/var/run/adblock-fast-monitor';
const JOB_FILE = RUN_DIR + '/job.json';
const UCI_SAVEDIR = RUN_DIR + '/uci';
const LOCK_DIR = '/var/lock';
const LOCK_FILE = LOCK_DIR + '/adblock-fast-monitor.lock';
const JOB_BIN = '/usr/libexec/adblock-fast-monitor/job.uc';
const QUEUE_WINDOW = 30;
const TERMINAL = { applied: true, partial: true, failed: true };
const UNSUPPORTED_DNS = /^(smartdns|unbound)\./;

function fail(code, message, extra) {
	let r = { api: API, ok: false, error: { code, message } };
	for (let k, v in extra)
		r[k] = v;
	return r;
}

function ensure_dir(path) {
	if (!fs.stat(path))
		fs.mkdir(path, 0700);
}

// Reads committed UCI only: the private savedir never holds another session's
// staged changes (LuCI stages in /var/run/rpcd/uci-<sid>, the CLI in /tmp/.uci).
function cursor() {
	ensure_dir(RUN_DIR);
	ensure_dir(UCI_SAVEDIR);
	return uci.cursor(null, UCI_SAVEDIR);
}

// adblock-fast state through abfm.system (committed UCI only).
function af_state(c, conn) {
	c.load('adblock-fast');
	return sys.adblock_fast_state(c, conn);
}

function protect_ctx(c, af) {
	c.load('dhcp');
	c.load('system');
	let p = sys.adblock_fast_protected(c, af);
	return dom.protect_context(p.names, p.hosts);
}

// --- job.json and lock (§7.3) ---

function read_job() {
	let data = fs.readfile(JOB_FILE);
	if (!data)
		return null;
	try {
		let j = json(data);
		return (type(j) == 'object') ? j : null;
	}
	catch (e) {
		return null;
	}
}

function write_job(job) {
	ensure_dir(RUN_DIR);
	let tmp = JOB_FILE + '.tmp';
	fs.unlink(tmp);
	let f = fs.open(tmp, 'wx', 0600);
	if (!f)
		return false;
	let ok = f.write(sprintf('%J', job)) != null;
	f.close();
	return ok && fs.rename(tmp, JOB_FILE);
}

function lock_try() {
	if (!fs.stat(LOCK_DIR))
		fs.mkdir(LOCK_DIR, 0755);
	let f = fs.open(LOCK_FILE, 'ae', 0600);
	if (!f)
		return null;
	if (!f.lock('xn')) {
		f.close();
		return null;
	}
	return f;
}

function unlock(f) {
	f.lock('u');
	f.close();
}

// With the lock held, a non-terminal job.json belongs to a dead job.
function reap_locked(job, now) {
	if (!job || TERMINAL[job.state])
		return job;
	let code = null;
	if (job.state == 'applying' || job.state == 'verifying')
		code = [ 'interrupted', 'the job process ended before it finished' ];
	else if (job.state == 'queued' && now - (job.created_at ?? 0) >= QUEUE_WINDOW)
		code = [ 'start-timeout', 'the job did not start' ];
	if (!code)
		return job;
	job.state = 'failed';
	job.finished_at = now;
	job.error = { code: code[0], message: code[1] };
	for (let it in job.items ?? [])
		if (it.result == 'pending')
			it.result = 'unverified';
	write_job(job);
	return job;
}

function job_view(job) {
	if (!job)
		return null;
	let v = { ...job };
	delete v.ctx;
	return v;
}

function new_job_id(now) {
	let rnd = fs.readfile('/dev/urandom', 2);
	return sprintf('j%010d-%s', now, rnd ? hexenc(rnd) : sprintf('%04x', (now * 7919) % 65536));
}

// --- methods ---

function m_info() {
	let c = cursor();
	let conn = ubus.connect();
	let af = af_state(c, conn);
	c.load('adblock-fast-monitor');
	c.load('dhcp');
	c.load('system');
	let mon = sys.monitor_config(c);
	let dnsmasq = sys.dnsmasq_info(c, conn);
	conn?.disconnect();

	let warnings = [];
	for (let i in dnsmasq.instances)
		if (i.dropin || i.uci_logqueries) {
			push(warnings, 'query-logging-active');
			break;
		}
	if (c.get_first('system', 'system', 'log_file'))
		push(warnings, 'logd-to-flash');
	if (c.get_first('system', 'system', 'log_ip'))
		push(warnings, 'logd-remote');

	return {
		api: API, ok: true,
		monitor: {
			query_logging: mon.query_logging,
			dnsmasq_instance: mon.dnsmasq_instance,
			exclude_router: mon.exclude_router,
			poll_interval: mon.poll_interval,
		},
		local_domains: sys.local_domains(c),
		logd: { size_kib: sys.logd_size_kib(c) },
		adblock_fast: {
			installed: af.installed, enabled: af.enabled, status: af.status, dns: af.dns,
			output_file: af.output_file, output_exists: af.output_exists,
			external_config: af.external_config, pending_uci_changes: af.pending_uci_changes,
		},
		dnsmasq,
		warnings,
	};
}

function m_apply(req) {
	let args = req.args ?? {};
	let now = time();
	let c = cursor();
	let conn = ubus.connect();
	let af = af_state(c, conn);
	conn?.disconnect();

	// Steps 1-3.
	let v = dom.validate_batch(args, af.installed ? protect_ctx(c, af) : dom.protect_context([], []));
	if (v.error)
		return { api: API, ok: false, error: v.error };

	// Step 4.
	if (!af.installed)
		return fail('adblock-fast-missing', 'adblock-fast is not installed');
	if (af.external_config)
		return fail('external-config', 'adblock-fast uses an external dnsmasq config file');
	if (match(af.dns, UNSUPPORTED_DNS) || !dom.DNSMASQ_MODES[af.dns])
		return fail('unsupported-dns-mode', `adblock-fast dns mode ${af.dns} is not supported`);
	if (af.pending_uci_changes)
		return fail('pending-uci-changes', 'adblock-fast has uncommitted changes in /tmp/.uci; commit or revert them first');

	// Step 5.
	let p = dom.plan(v.ops, { allowed: af.allowed, blocked: af.blocked, enabled: af.enabled, rebuild: args.rebuild === true });
	if (p.error)
		return { api: API, ok: false, error: p.error };
	let plan = dom.plan_view(p.items);
	if (p.noop)
		return { api: API, ok: true, noop: true, job_id: null, mode: p.mode, plan };

	// Steps 6-7.
	if (p.mode == 'rebuild' && args.confirm_rebuild !== true)
		return fail('confirm-required', 'this change rebuilds the block-list: it downloads all lists over WAN, restarts DNS and may take minutes',
			{ mode: p.mode, plan });
	if (args.dry_run === true)
		return { api: API, ok: true, dry_run: true, noop: false, mode: p.mode, may_escalate: p.may_escalate, plan };

	// Step 8.
	let lock = lock_try();
	if (!lock)
		return fail('busy', 'another job is running', { job_id: read_job()?.id ?? null });
	let prev = reap_locked(read_job(), now);
	if (prev?.state == 'queued') {
		unlock(lock);
		return fail('busy', 'another job is starting', { job_id: prev.id });
	}

	// Step 9.
	let changes = 0;
	for (let it in p.items) {
		for (let ch in it.change) {
			let parts = split(ch, ':');
			let opt = (parts[0] == 'allow') ? 'allowed_domain' : 'blocked_domain';
			let ok = (parts[1] == 'add')
				? c.list_append('adblock-fast', 'config', opt, it.domain)
				: c.list_remove('adblock-fast', 'config', opt, it.domain);
			if (!ok) {
				c.revert('adblock-fast');
				unlock(lock);
				return fail('uci-error', `cannot update adblock-fast.config.${opt}: ${uci.error() ?? 'unknown error'}`);
			}
			changes++;
		}
	}
	if (changes && !c.commit('adblock-fast')) {
		c.revert('adblock-fast');
		unlock(lock);
		return fail('uci-error', `cannot commit adblock-fast: ${uci.error() ?? 'unknown error'}`);
	}

	// Step 10.
	let id = new_job_id(now);
	let job = {
		id, state: 'queued', mode: p.mode, phase: null,
		created_at: now, started_at: null, finished_at: null,
		persisted: changes > 0, escalated: false,
		adblock_fast_status: af.status, error: null,
		items: map(p.items, (it) => ({
			op: it.op, domain: it.domain, effective_op: it.effective_op, change: it.change,
			expect: it.expect, result: 'pending', observed: null, answer: null, reason: null,
		})),
		ctx: { dns: af.dns, output_file: af.output_file },
	};
	let written = write_job(job);
	unlock(lock);
	if (!written)
		return fail('spawn-failed', 'cannot write the job state', { persisted: changes > 0 });

	// Step 11.
	let rc = fs.access(JOB_BIN, 'x')
		? system(`S=$(command -v setsid); exec </dev/null >/dev/null 2>&1; $S ${JOB_BIN} ${id} &`)
		: -1;
	if (rc != 0)
		return fail('spawn-failed', 'cannot start the job', { persisted: changes > 0, job_id: id });

	return { api: API, ok: true, job_id: id, state: 'queued', mode: p.mode, may_escalate: p.may_escalate, plan };
}

function m_job(req) {
	let want = req.args?.job_id;
	if (want != null && !dom.valid_job_id(want))
		return fail('not-found', 'no such job');
	let job = read_job();
	if (job && !TERMINAL[job.state]) {
		let lock = lock_try();
		if (lock) {
			job = reap_locked(read_job(), time());
			unlock(lock);
		}
	}
	if (want != null && job?.id != want)
		return fail('not-found', 'no such job');
	return { api: API, ok: true, job: job_view(job) };
}

return {
	'luci.adblock-fast-monitor': {
		info: { args: {}, call: m_info },
		apply: { args: { ops: [], confirm_rebuild: true, rebuild: true, dry_run: true }, call: m_apply },
		job: { args: { job_id: '' }, call: m_job },
	},
};
