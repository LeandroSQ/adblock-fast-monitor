{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime test manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixtureLists", "requiredAdapters", "performanceBudgets"],
  "properties": {
    "fixtureLists": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^test/fixtures/lists/[A-Za-z0-9._-]+\\.txt$" }
    },
    "requiredAdapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "qemu", "performance"],
      "properties": {
        "browser": { "const": "test/browser/" },
        "qemu": { "const": "scripts/integration/runtime-dns-lifecycle.sh" },
        "performance": { "const": "root/test/performance/results.json" }
      }
    },
    "performanceBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dnsQueryP95Ms", "peakRssMiB", "refreshSeconds"],
      "properties": {
        "dnsQueryP95Ms": { "type": "number", "exclusiveMinimum": 0 },
        "peakRssMiB": { "type": "number", "exclusiveMinimum": 0 },
        "refreshSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
