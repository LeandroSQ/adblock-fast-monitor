#   package/utils/ucode/Makefile        PKG_SOURCE_VERSION
#   package/libs/libubox/Makefile       PKG_SOURCE_VERSION
#   package/system/ubus/Makefile        PKG_SOURCE_VERSION
#   package/system/uci/Makefile         PKG_SOURCE_VERSION
#   package/utils/jsonfilter/Makefile   PKG_SOURCE_VERSION
#   package/utils/busybox/Makefile      PKG_VERSION / PKG_HASH
# Change them together, and only to match a newer OpenWrt release.
