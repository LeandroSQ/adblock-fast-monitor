#!/bin/sh /etc/rc.common
# TEST-ONLY stand-in for WU1's init script (docs/CONTRACT.md §4.1, §5).
# Installed by install.sh only when the browser suite runs with ABFM_UI_STUB=1.
START=18
USE_PROCD=1
DROPIN=adblock-fast-monitor.conf
CHANGED=0

confdir_of() {
	local cd
	config_get cd "$1" confdir "/tmp/dnsmasq.$1.d"
	echo "${cd%%,*}"
}

dropin_add() {
	local s="$1" dis lq cd
	config_get_bool dis "$s" disabled 0
	config_get_bool lq "$s" logqueries 0
	[ "$dis" = 1 ] && return 0
	cd="$(confdir_of "$s")"
	case "$cd" in /*) ;; *) return 0 ;; esac
	if [ "$lq" = 1 ]; then
		[ -e "$cd/$DROPIN" ] && rm -f "$cd/$DROPIN" && CHANGED=1
		return 0
	fi
	[ -e "$cd/$DROPIN" ] && return 0
	mkdir -p "$cd" && echo 'log-queries=extra' >"$cd/.$DROPIN.tmp" && mv "$cd/.$DROPIN.tmp" "$cd/$DROPIN" && CHANGED=1
}

dropin_del() {
	local cd
	cd="$(confdir_of "$1")"
	[ -e "$cd/$DROPIN" ] && rm -f "$cd/$DROPIN" && CHANGED=1
	return 0
}

logging() {
	CHANGED=0
	config_load dhcp
	if [ "$1" = enable ]; then config_foreach dropin_add dnsmasq; else config_foreach dropin_del dnsmasq; fi
	if [ "$CHANGED" = 1 ] && ubus call service list '{"name":"dnsmasq"}' 2>/dev/null | grep -q '"running": true'; then
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi
}

start_service() {
	local en ml
	config_load adblock-fast-monitor
	config_get_bool en config enabled 0
	config_get_bool ml config manage_logging 1
	if [ "$en" != 1 ]; then logging disable; return 0; fi
	if [ "$ml" = 1 ]; then logging enable; else logging disable; fi
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/libexec/adblock-fast-monitor/stub-monitord.uc
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/adblock-fast-monitor
	procd_close_instance
}

stop_service() { logging disable; }

service_triggers() { procd_add_reload_trigger adblock-fast-monitor; }
